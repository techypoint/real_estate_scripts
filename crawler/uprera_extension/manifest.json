{
  "manifest_version": 3,
  "name": "UP-RERA Detail Collector",
  "version": "1.0",
  "description": "Auto-captures UP-RERA project detail pages as you browse and exports them to JSON/CSV.",
  "permissions": ["storage", "downloads"],
  "host_permissions": ["https://www.up-rera.in/*", "https://upreradisk.blob.core.windows.net/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://www.up-rera.in/*"
      ],
      "run_at": "document_idle",
      "js": ["common.js", "content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "UP-RERA Collector"
  }
}
