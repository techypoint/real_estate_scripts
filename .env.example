MONGODB_URI=mongodb://<user>:<password>@localhost:27018/real_estate_uprera?authSource=admin

# Cloudflare R2 (S3-compatible object storage) — this repo writes here;
# real_estate_backend only reads the base URL (CdnUrlResolver composes stored
# object keys into absolute URLs, it never talks to R2 directly).
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_BUCKET=acreinfotech-storage
ACCESS_KEY=<r2-access-key-id>
SECRET_ACCESS_KEY=<r2-secret-access-key>
# Custom domain routed to the R2 bucket. Also set in real_estate_backend
# (app.cdn-base-url) and real_estate_frontend (images.remotePatterns) if this
# ever changes.
CDN_BASE_URL=https://media.acreinfotech.com

# agentic_ai_workflow dashboard — crons/ scripts POST here to start content
# pipeline runs. See SOCIAL_CONTENT_PIPELINE.md there.
DASHBOARD_URL=http://127.0.0.1:4000
# Every route on the dashboard now requires auth (its own src/proxy.ts) —
# this must match agentic_ai_workflow's CRON_API_TOKEN exactly, or every
# cron in this repo starts failing with 401s. See lib/dashboardApi.mjs.
DASHBOARD_API_TOKEN=<same value as agentic_ai_workflow's CRON_API_TOKEN>

# real_estate_frontend — crons/listing_content.mjs links to the listing in
# the content it triggers. Not used for anything functional, just copy.
FRONTEND_URL=http://localhost:3000
